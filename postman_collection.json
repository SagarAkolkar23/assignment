{
  "info": {
    "name": "Healthcare Backend API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Django + DRF + PostgreSQL Healthcare Backend endpoints"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "access_token", "value": "" },
    { "key": "patient_id", "value": "1" },
    { "key": "doctor_id", "value": "1" },
    { "key": "mapping_id", "value": "1" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{access_token}}", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/auth/register/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Smith\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"StrongPassword123!\"\n}"
            }
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.access) { pm.collectionVariables.set('access_token', res.access); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/auth/login/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"StrongPassword123!\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Patients",
      "item": [
        {
          "name": "Create Patient",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/patients/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"age\": 35,\n  \"gender\": \"Male\",\n  \"phone\": \"+1-555-234-5678\",\n  \"email\": \"john.doe@example.com\",\n  \"address\": \"123 Main St\",\n  \"medical_history\": \"No known allergies\"\n}"
            }
          }
        },
        {
          "name": "List My Patients",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/patients/"
          }
        },
        {
          "name": "Get Patient by ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/patients/{{patient_id}}/"
          }
        },
        {
          "name": "Update Patient",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/patients/{{patient_id}}/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"age\": 36,\n  \"gender\": \"Male\",\n  \"phone\": \"+1-555-234-5678\",\n  \"email\": \"john.doe@example.com\",\n  \"address\": \"456 Oak Ave\",\n  \"medical_history\": \"Updated checkup\"\n}"
            }
          }
        },
        {
          "name": "Delete Patient",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/patients/{{patient_id}}/"
          }
        }
      ]
    },
    {
      "name": "Doctors",
      "item": [
        {
          "name": "Create Doctor",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/doctors/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sarah Connor\",\n  \"specialization\": \"Cardiology\",\n  \"email\": \"sarah.connor@hospital.org\",\n  \"phone\": \"+1-555-888-9999\",\n  \"years_of_experience\": 12\n}"
            }
          }
        },
        {
          "name": "List All Doctors",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/doctors/"
          }
        },
        {
          "name": "Get Doctor by ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/doctors/{{doctor_id}}/"
          }
        },
        {
          "name": "Update Doctor",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/doctors/{{doctor_id}}/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sarah Connor\",\n  \"specialization\": \"Interventional Cardiology\",\n  \"email\": \"sarah.connor@hospital.org\",\n  \"phone\": \"+1-555-888-9999\",\n  \"years_of_experience\": 13\n}"
            }
          }
        },
        {
          "name": "Delete Doctor",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/doctors/{{doctor_id}}/"
          }
        }
      ]
    },
    {
      "name": "Mappings",
      "item": [
        {
          "name": "Assign Doctor to Patient",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/mappings/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patient\": 1,\n  \"doctor\": 1,\n  \"notes\": \"Primary cardiologist\"\n}"
            }
          }
        },
        {
          "name": "List All Mappings",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/mappings/"
          }
        },
        {
          "name": "Get Doctors for Patient",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/mappings/{{patient_id}}/"
          }
        },
        {
          "name": "Remove Mapping",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/mappings/{{mapping_id}}/"
          }
        }
      ]
    }
  ]
}
